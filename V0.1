class theif:
    def __init__(self, fi, fo, ti, ha, mu, re, ph, le, br, tim, ca):
        self.chance=1
        self.fingerprints=fi
        self.footprints=fo
        self.tiretracks=ti
        self.hairstrands=ha
        self.murder=mu
        self.recording=re
        self.photos=ph
        self.letters=le
        self.time=tim
        self.breakin=br
        self.callingcard=ca
    def showinfo(self):
        print("\n", f"{self.chance}=chance", "\n", f"{self.fingerprints}=fingerprints", "\n", f"{self.footprints}=footprints", "\n", f"{self.tiretracks}=tiretracks", "\n", f"{self.hairstrands}=hairstrands", "\n", f"{self.murder}=murder", "\n", f"{self.recording}=recording", "\n", f"{self.photos}=photos", "\n", f"{self.letters}=letters", "\n", f"{self.time}=time", "\n", f"{self.breakin}=breakin", "\n", f"{self.callingcard}=callingcard")
    def __add__(self, num):
        return self.chance + num
    def __str__(self):
        return self.callingcard
